  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "57.0.3",
    "leaflet": "1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/database.test.ts",
    "test:live": "node scripts/live-auth.mjs",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --output-dir dist-android && expo export --platform ios --output-dir dist-ios",
    "check": "npm run typecheck && npm run typecheck:edge && npm run lint && npm test",
    "seed:dev": "node scripts/seed-dev.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "test:e2e": "node scripts/smoke-web.mjs",
    "retention": "node scripts/retention.mjs",
    "format": "prettier --write app src tests scripts supabase/functions *.ts *.json *.js",
    "typecheck:edge": "tsc --noEmit -p tsconfig.edge.json",
    "preview": "node scripts/preview.mjs",
    "test:e2e:connected": "node scripts/smoke-connected.mjs",
    "test:e2e:admin": "node scripts/smoke-admin.mjs"
  },
  "private": true
}
